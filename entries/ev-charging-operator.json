    {
      "tag": "high_fixed_cost",
      "text": "Revenue depends on energy sold while fixed costs do not shrink, so payback is long",
      "evidence": "documented"
    },
    {
      "tag": "grid_capacity",
      "text": "Grid capacity increasingly constrains where operators can build",
      "evidence": "documented"
    }
